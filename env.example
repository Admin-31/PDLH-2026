# PostgreSQL untuk deployment / produksi
DATABASE_URL=postgresql://postgres:password@localhost:5432/loket_konferensi
SESSION_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
PORT=3000
NODE_ENV=development
# Akun awal dibuat oleh npm run seed. Ganti password sesudah login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPassword123!
# Untuk hosting gambar eksternal, isi URL dasar penyimpanan yang Anda gunakan.
UPLOAD_DIR=uploads
